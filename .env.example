# The Anthropic SDK reads this directly. Never commit the real one.
ANTHROPIC_API_KEY=

# Service settings, all optional; the values shown are the defaults.
CREDENCE_EXTRACTION_MODEL=claude-opus-5-5
CREDENCE_PROMPT_VERSION=v1
CREDENCE_EFFORT=medium
CREDENCE_MAX_OUTPUT_TOKENS=16000
CREDENCE_REQUEST_TIMEOUT_S=120
