# The Anthropic SDK reads this directly. Never commit the real one.
ANTHROPIC_API_KEY=

# Service settings, all optional; the values shown are the defaults.
CREDENCE_EXTRACTION_MODEL=claude-opus-5-5
CREDENCE_PROMPT_VERSION=v1
CREDENCE_EFFORT=medium
CREDENCE_MAX_OUTPUT_TOKENS=16000
CREDENCE_REQUEST_TIMEOUT_S=120
CREDENCE_MAX_DOCUMENT_PAGES=20

# The API. The database URL matches compose.yaml. Leave CREDENCE_API_KEY empty
# on a laptop; set it anywhere else and send it as X-API-Key.
CREDENCE_DATABASE_URL=postgresql+psycopg://credence:credence@localhost:5432/credence
CREDENCE_STORAGE_DIR=data/documents
CREDENCE_API_KEY=
